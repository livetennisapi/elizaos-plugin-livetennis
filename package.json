{
  "name": "elizaos-plugin-livetennis",
  "version": "0.1.2",
  "description": "Live tennis scores, upcoming fixtures, and player search for elizaOS agents via the Live Tennis API \u2014 ATP, WTA, Challenger, ITF and juniors. FREE-tier endpoints only, with honest per-action tier errors.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Synapse Research Ltd",
    "email": "hello@livetennisapi.com",
    "url": "https://synapsereality.io"
  },
  "homepage": "https://livetennisapi.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/livetennisapi/elizaos-plugin-livetennis.git"
  },
  "bugs": {
    "url": "https://github.com/livetennisapi/elizaos-plugin-livetennis/issues"
  },
  "keywords": [
    "elizaos",
    "elizaos-plugin",
    "plugin",
    "tennis",
    "tennis-api",
    "live-scores",
    "sports",
    "sports-api",
    "sports-data",
    "atp",
    "wta",
    "fixtures",
    "rankings"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageType": "plugin",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "eliza-source": {
        "types": "./src/index.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "elizaos.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config ./vitest.config.ts",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@elizaos/core": "^2.0.3-beta.7"
  },
  "devDependencies": {
    "@elizaos/core": "2.0.3-beta.7",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {
      "LIVETENNIS_API_KEY": {
        "type": "string",
        "description": "Live Tennis API key. A FREE key is self-serve at https://livetennisapi.com/subscribe/free (30 requests/minute, 100/day, no card)."
      }
    }
  }
}
